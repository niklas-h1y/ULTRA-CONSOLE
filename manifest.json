{
  "manifest_version": 3,
  "name": "ULTRA-CONSOLE",
  "short_name": "ULTRA",
  "version": "2.1.0",
  "description": "A full-featured developer console extension for inspecting and debugging web pages.",
  "action": {"default_title":"Open ULTRA-CONSOLE","default_popup":"popup/index.html"},
  "background": {"service_worker":"background.js"},
  "devtools_page": "devtools/devtools.html",
  "options_page": "options/index.html",
  "content_scripts": [{"matches":["<all_urls>"],"js":["content/content.js"],"css":["content/content.css"],"run_at":"document_start"}],
  "web_accessible_resources": [{"resources":["content/page-hook.js"],"matches":["<all_urls>"]}],
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}