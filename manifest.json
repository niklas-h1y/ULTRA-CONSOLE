{
  "manifest_version": 3,
  "name": "ULTRA-CONSOLE",
  "version": "2.0.0",
  "description": "A powerful in-page developer console and page inspector.",
  "action": {
    "default_title": "ULTRA-CONSOLE",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ultra-console@example.com",
      "strict_min_version": "128.0"
    }
  },
  "minimum_chrome_version": "111"
}
